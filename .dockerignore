# ==========================================
# TensorForge 2.0 - Docker Build Ignore Rules
# ==========================================

# Version control
.git
.gitignore

# Environment & credentials (API_KEY must be passed via docker run -e)
.env
.env.*
!.env.example

# Python cache & virtual environments
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# IDEs & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary / scratch / runtime jobs
tmp/
scratch/
runtime/jobs/*

# Node modules (huge! never send to docker context)
frontend/node_modules/

# Raw datasets & training scripts (not needed for inference runtime)
data/
ml/notebooks/
ml/training/
ml/evaluation/
docs/

